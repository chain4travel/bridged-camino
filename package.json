{
    "name": "bridged-camino",
    "description": "An ERC20-based token for bridged CAM on other chains",
    "version": "1.0.0",
    "packageManager": "yarn@4.11.0",
    "scripts": {
        "test": "yarn hardhat test",
        "compile": "yarn hardhat compile",
        "format": "yarn prettier --write .",
        "docgen": "yarn hardhat docgen && yarn prettier --write docs/api",
        "lint:prettier": "yarn prettier --check .",
        "deploy": "yarn hardhat cam deploy"
    },
    "devDependencies": {
        "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
        "@nomicfoundation/hardhat-ethers": "^3.1.2",
        "@nomicfoundation/hardhat-ignition": "^0.15.15",
        "@nomicfoundation/hardhat-ignition-ethers": "^0.15.16",
        "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
        "@nomicfoundation/hardhat-toolbox": "^5.0.0",
        "@nomicfoundation/hardhat-verify": "^2.1.3",
        "@nomicfoundation/ignition-core": "^0.15.14",
        "@openzeppelin/contracts": "~5.3.0",
        "@openzeppelin/contracts-upgradeable": "~5.3.0",
        "@openzeppelin/hardhat-upgrades": "^3.9.1",
        "@typechain/ethers-v6": "^0.5.1",
        "@typechain/hardhat": "^9.1.0",
        "@types/chai": "^4.3.20",
        "@types/mocha": "^10.0.10",
        "@types/node": "^20.19.25",
        "chai": "^4.5.0",
        "ethers": "^6.15.0",
        "hardhat": "^2.27.0",
        "hardhat-contract-sizer": "^2.10.1",
        "hardhat-gas-reporter": "^2.3.0",
        "prettier": "^3.6.2",
        "prettier-plugin-solidity": "^1.4.3",
        "solidity-coverage": "^0.8.16",
        "solidity-docgen": "^0.6.0-beta.36",
        "ts-node": "^10.9.2",
        "typechain": "^8.3.2",
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "enquirer": "^2.4.1"
    }
}
